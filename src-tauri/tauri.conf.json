{
  "productName": "MossImage Layout Editor",
  "identifier": "com.github.hybskgks28275.mossimage-layout-editor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MossImage Layout Editor",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "visible": false,
        "backgroundColor": "#0c1421",
        "dragDropEnabled": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: https://ipc.localhost; base-uri 'none'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
